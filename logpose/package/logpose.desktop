[Desktop Entry]
Version=1.0
Type=Application
Name=Log Pose
GenericName=Navegador
GenericName[en]=Web Browser
Comment=Navegue na web
Comment[en]=Browse the web
Exec=@BIN@ %U
Icon=logpose
Terminal=false
StartupNotify=true
StartupWMClass=logpose
Categories=Network;WebBrowser;
MimeType=application/pdf;application/xhtml+xml;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;browser;internet;navegador;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=Nova janela
Name[en]=New Window
Exec=@BIN@ --new-window

[Desktop Action new-private-window]
Name=Nova janela anônima
Name[en]=New Incognito Window
Exec=@BIN@ --incognito
