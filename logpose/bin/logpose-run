#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="${LOGPOSE_PROFILE:-$HOME/.local/share/logpose/dev-profile}"
onepassword="$HOME/.config/chromium/NativeMessagingHosts/com.1password.1password.json"

if [ -f "$onepassword" ] && [ ! -f "$profile/NativeMessagingHosts/com.1password.1password.json" ]; then
  mkdir -p "$profile/NativeMessagingHosts"
  cp "$onepassword" "$profile/NativeMessagingHosts/"
fi

# a versão da extensão não muda entre edições e o Chromium seguiria rodando o background.js
# guardado no perfil; quando os arquivos da barra mudam, apaga o registro do service worker
stamp="$(cd "$root/logpose/sidebar" && find . -type f ! -name '*.test.js' -print0 | sort -z | xargs -0 cat | cksum)"
if [ "$(cat "$profile/.logpose-sidebar-stamp" 2>/dev/null)" != "$stamp" ]; then
  rm -rf "$profile/Default/Service Worker"
  mkdir -p "$profile" && echo "$stamp" > "$profile/.logpose-sidebar-stamp"
fi

export LANGUAGE="${LOGPOSE_LANGUAGE:-pt_BR}"
exec "$root/build/src/out/Default/logpose" \
  --user-data-dir="$profile" \
  --ozone-platform=wayland \
  --logpose-sidebar-dir="$root/logpose/sidebar" \
  ${LOGPOSE_EXTRA_EXTENSIONS:+--load-extension="$LOGPOSE_EXTRA_EXTENSIONS"} \
  "$@"
