#!/usr/bin/env bash
set -uo pipefail

# Log Pose headless num perfil descartável, sem janela na tela; a barra abre como aba e o CDP fica na porta $debug_port
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
binary="${LOGPOSE_BINARY:-$root/build/src/out/Default/logpose}"
extension="$root/logpose/sidebar"
extension_id="hncljkmljckjojdjincglklbdihcaeko"
debug_port="${LOGPOSE_DEBUG_PORT:-9333}"
profile="${XDG_RUNTIME_DIR:-/tmp}/logpose-sandbox"

usage() {
  echo "uso: logpose-sandbox up | eval <js> [pagina] | shot <saida.png> [largura altura] | down" >&2
  exit 2
}

stop() {
  pkill -f "^$binary .*--user-data-dir=$profile" && sleep 1
}

case "${1:-}" in
  up)
    stop
    rm -rf "$profile"
    mkdir -p "$profile"
    first_run=(--no-first-run)
    [ -n "${LOGPOSE_FIRST_RUN:-}" ] && first_run=()
    setsid -f env LANGUAGE="${LOGPOSE_LANGUAGE:-pt_BR}" "$binary" --headless=new --user-data-dir="$profile" "${first_run[@]}" \
      --logpose-sidebar-dir="$extension" ${LOGPOSE_EXTRA_EXTENSIONS:+--load-extension="$LOGPOSE_EXTRA_EXTENSIONS"} --password-store=basic \
      --remote-debugging-port="$debug_port" --window-size=1400,900 "chrome-extension://$extension_id/sidebar.html" >"${LOGPOSE_LOG:-/dev/null}" 2>&1
    timeout 30 bash -c "until curl -s localhost:$debug_port/json/list | grep -q sidebar.html; do sleep 1; done"
    sleep 2
    ;;
  eval)
    node "$root/logpose/bin/logpose-eval.mjs" "$debug_port" "$extension_id" "${2:?expressao}" "${3:-sidebar.html}"
    ;;
  shot)
    node "$root/logpose/bin/logpose-eval.mjs" "$debug_port" "$extension_id" --shot "${2:?saida.png}" "${3:-360}" "${4:-800}"
    ;;
  down)
    stop
    rm -rf "$profile"
    ;;
  *)
    usage
    ;;
esac
