#!/usr/bin/env bash
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
sandbox="${CIEL_SANDBOX_BIN:-$HOME/dotfiles/shell/bin/ciel-sandbox}"
name="${LOGPOSE_SANDBOX:-logpose}"
binary="${LOGPOSE_BINARY:-$root/build/src/out/Default/logpose}"
extension="$root/logpose/sidebar"
extension_id="hncljkmljckjojdjincglklbdihcaeko"
debug_port="${LOGPOSE_DEBUG_PORT:-9333}"

usage() {
  echo "uso: logpose-sandbox up | open [url...] | key <tecla> [modificador...] | eval <js> [pagina] | shot <saida.png> | theme <id> | down" >&2
  exit 2
}

in_sandbox() {
  "$sandbox" run "$name" -- "$@"
}

profile() {
  in_sandbox bash -c 'echo "$HOME/.local/share/logpose/dev-profile"'
}

case "${1:-}" in
  up)
    "$sandbox" list | grep -qw "$name" || "$sandbox" new "$name" >/dev/null 2>&1
    "$sandbox" list | grep -qw "$name" || "$sandbox" start "$name"
    in_sandbox env LOGPOSE_PROFILE="$(profile)" "$root/logpose/bin/logpose-theme-install" "$extension_id"
    ;;
  open)
    shift
    p="$(profile)"
    first_run=(--no-first-run)
    [ -n "${LOGPOSE_FIRST_RUN:-}" ] && first_run=()
    pkill -f "^$binary --user-data-dir=$p"
    sleep 1
    in_sandbox setsid -f env LANGUAGE="${LOGPOSE_LANGUAGE:-pt_BR}" "$binary" --user-data-dir="$p" --ozone-platform=wayland \
      "${first_run[@]}" --logpose-sidebar-dir="$extension" ${LOGPOSE_EXTRA_EXTENSIONS:+--load-extension="$LOGPOSE_EXTRA_EXTENSIONS"} --password-store=basic --remote-debugging-port="$debug_port" --enable-logging=stderr "$@" >"${LOGPOSE_LOG:-/dev/null}" 2>&1
    in_sandbox timeout 30 bash -c 'until hyprctl clients -j | jq -e "any(.[]; .class==\"logpose\")" >/dev/null; do sleep 1; done'
    sleep 4
    ;;
  key)
    shift
    key="$1"; shift
    args=()
    for m in "$@"; do args+=(-M "$m"); done
    args+=(-k "$key")
    for m in "$@"; do args+=(-m "$m"); done
    in_sandbox wtype "${args[@]}"
    ;;
  shot)
    "$sandbox" shot "$name" "${2:?saida.png}"
    ;;
  eval)
    node "$root/logpose/bin/logpose-eval.mjs" "$debug_port" "$extension_id" "${2:?expressao}" "${3:-sidebar.html}"
    ;;
  theme)
    in_sandbox ciel theme set "${2:?id do tema}"
    in_sandbox "$root/logpose/theme/hook-theme-set"
    ;;
  down)
    "$sandbox" stop "$name"
    ;;
  *)
    usage
    ;;
esac
