#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cache="${LOGPOSE_SCCACHE_DIR:-$HOME/.cache/logpose/sccache}"
mkdir -p "$cache"

docker buildx build --load -t chromium-builder:trixie-slim \
    --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
    -f "$root/docker/build.Dockerfile" "$root/docker"
docker buildx build --load -t logpose-dev:trixie-slim \
    -f "$root/logpose/docker/dev.Dockerfile" "$root/logpose/docker"

tty_flags=(-i)
[ -t 0 ] && tty_flags+=(-t)

if [ $# -eq 0 ]; then
    set -- bash --rcfile scripts/dev.sh -i
else
    set -- bash -c "source scripts/dev.sh && $*"
fi

exec docker run --rm "${tty_flags[@]}" \
    -u "$(id -u):$(id -g)" \
    -v "$root:/repo" \
    -v "$cache:/sccache" \
    -e SCCACHE_DIR=/sccache \
    -e SCCACHE_CACHE_SIZE="${LOGPOSE_SCCACHE_SIZE:-20G}" \
    logpose-dev:trixie-slim "$@"
