+ExtensionFunction::ResponseAction LogposePrivateGetCrashedSessionFunction::Run() {
+  auto params = logpose_private::GetCrashedSession::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(
+      ArgumentList(logpose_private::GetCrashedSession::Results::Create(
+          LogPoseHasCrashedSession(browser))));
+}
+
+ExtensionFunction::ResponseAction
+LogposePrivateResolveCrashedSessionFunction::Run() {
+  auto params = logpose_private::ResolveCrashedSession::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  LogPoseResolveCrashedSession(browser, params->restore);
+  return RespondNow(NoArguments());
+}
