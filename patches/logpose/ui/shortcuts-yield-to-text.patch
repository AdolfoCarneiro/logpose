 #include "ui/base/class_property.h"
 #include "ui/events/event_constants.h"
 #include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/controls/webview/webview.h"
 #include "ui/views/focus/focus_manager.h"
 
 namespace {
 
+// Shortcuts are high priority accelerators, processed before the focused web
+// contents sees the key. Editing keys stay with a focused text field.
+bool YieldsToText(views::FocusManager* focus_manager,
+                  const ui::Accelerator& accelerator) {
+  switch (accelerator.key_code()) {
+    case ui::VKEY_LEFT:
+    case ui::VKEY_RIGHT:
+    case ui::VKEY_UP:
+    case ui::VKEY_DOWN:
+    case ui::VKEY_HOME:
+    case ui::VKEY_END:
+    case ui::VKEY_BACK:
+    case ui::VKEY_DELETE:
+      break;
+    default:
+      return false;
+  }
+  auto* web_view = focus_manager ? views::AsViewClass<views::WebView>(
+                                       focus_manager->GetFocusedView())
+                                 : nullptr;
+  return web_view && web_view->web_contents() &&
+         web_view->web_contents()->IsFocusedElementEditable();
+}
+
 std::map<ui::Accelerator, std::string>& Shortcuts() {
