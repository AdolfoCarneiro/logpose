+LogposePrivateGetSearchSuggestionsFunction::
+    LogposePrivateGetSearchSuggestionsFunction() = default;
+
+LogposePrivateGetSearchSuggestionsFunction::
+    ~LogposePrivateGetSearchSuggestionsFunction() = default;
+
+ExtensionFunction::ResponseAction
+LogposePrivateGetSearchSuggestionsFunction::Run() {
+  auto params = logpose_private::GetSearchSuggestions::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  Profile* profile = browser->GetProfile();
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  const std::u16string text = base::UTF8ToUTF16(params->text);
+  if (!engine || engine->suggestions_url().empty() || text.empty() ||
+      !profile->GetPrefs()->GetBoolean(prefs::kSearchSuggestEnabled)) {
+    return RespondNow(ArgumentList(
+        logpose_private::GetSearchSuggestions::Results::Create({})));
+  }
+  const GURL url(engine->suggestions_url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(text), service->search_terms_data()));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return RespondNow(ArgumentList(
+        logpose_private::GetSearchSuggestions::Results::Create({})));
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("logpose_search_suggestions", R"(
+        semantics {
+          sender: "Log Pose spotlight"
+          description:
+            "Asks the default search engine for search suggestions while "
+            "the user types in the spotlight, as the address bar does."
+          trigger: "Typing in the spotlight."
+          data: "The text typed in the spotlight."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Log Pose settings, Busca e início, Sugestões de pesquisa."
+          policy_exception_justification: "Not implemented."
+        })");
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->DownloadToString(
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&LogposePrivateGetSearchSuggestionsFunction::OnLoaded,
+                     this),
+      64 * 1024);
+  return RespondLater();
+}
+
+void LogposePrivateGetSearchSuggestionsFunction::OnLoaded(
+    std::optional<std::string> body) {
+  std::vector<std::string> suggestions;
+  std::optional<base::Value> json =
+      body ? base::JSONReader::Read(*body, base::JSON_PARSE_RFC)
+           : std::nullopt;
+  const base::ListValue* list = json ? json->GetIfList() : nullptr;
+  const base::ListValue* found =
+      list && list->size() > 1 ? (*list)[1].GetIfList() : nullptr;
+  if (found) {
+    for (const base::Value& entry : *found) {
+      if (entry.is_string() && suggestions.size() < 8) {
+        suggestions.push_back(entry.GetString());
+      }
+    }
+  }
+  Respond(ArgumentList(
+      logpose_private::GetSearchSuggestions::Results::Create(suggestions)));
+}
