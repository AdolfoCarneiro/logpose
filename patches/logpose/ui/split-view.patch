+ExtensionFunction::ResponseAction LogposePrivateDragTabFunction::Run() {
+  auto params = logpose_private::DragTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(ArgumentList(logpose_private::DragTab::Results::Create(
+      LogPoseDragTab(browser, GetSenderWebContents(),
+                   gfx::Point(params->x, params->y), params->zones))));
+}
+
+ExtensionFunction::ResponseAction LogposePrivateEndTabDragFunction::Run() {
+  auto params = logpose_private::EndTabDrag::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  LogPoseEndTabDrag(browser);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction LogposePrivateArrangeSplitFunction::Run() {
+  auto params = logpose_private::ArrangeSplit::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    if (ExtensionTabUtil::GetTabId(model->GetWebContentsAt(i)) !=
+        params->tab_id) {
+      continue;
+    }
+    std::optional<split_tabs::SplitTabId> split =
+        model->GetTabAtIndex(i)->GetSplit();
+    if (!split) {
+      break;
+    }
+    const std::string& zone = params->zone;
+    model->UpdateSplitLayout(*split, zone == "top" || zone == "bottom"
+                                         ? split_tabs::SplitTabLayout::kStacked
+                                         : split_tabs::SplitTabLayout::kSideBySide);
+    const bool first =
+        static_cast<int>(model->GetSplitData(*split)->GetIndexRange().start()) == i;
+    if (first != (zone == "left" || zone == "top")) {
+      model->ReverseTabsInSplit(*split);
+    }
+    return RespondNow(NoArguments());
+  }
+  return RespondNow(Error("Tab " + base::NumberToString(params->tab_id) +
+                          " is not in a split."));
+}
