+bool LogPoseOwnsWindow(BrowserView* browser_view) {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             "logpose-native-chrome") &&
+         browser_view->browser()->GetType() ==
+             BrowserWindowInterface::Type::TYPE_NORMAL &&
+         !LogPoseIsLittle(browser_view->browser());
+}
+
+LogPoseSpotlightView* LogPosePaneOverlay(BrowserView* browser_view,
+                                     std::string_view page) {
+  if (LogPoseSpotlightView* found = LogPoseFindOverlay(browser_view, page)) {
+    return found;
+  }
+  views::View* holder = browser_view->multi_contents_view();
+  while (holder && holder->parent() != browser_view) {
+    holder = holder->parent();
+  }
+  LogPoseSpotlightView* overlay = LogPoseOverlayFor(browser_view, page);
+  if (holder) {
+    browser_view->ReorderChildView(
+        overlay, *browser_view->GetIndexOf(holder) + 1);
+  }
+  return overlay;
+}
+
+views::WebView* LogPoseWebViewOf(views::View* root,
+                               content::WebContents* contents) {
+  if (auto* web = views::AsViewClass<views::WebView>(root);
+      web && web->web_contents() == contents) {
+    return web;
+  }
+  for (views::View* child : root->children()) {
+    if (views::WebView* found = LogPoseWebViewOf(child, contents)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+void LogPoseLayoutPanes(BrowserView* browser_view) {
+  if (!LogPoseOwnsWindow(browser_view)) {
+    return;
+  }
+  constexpr int kWidth = 116;
+  constexpr int kHeight = 44;
+  MultiContentsView* multi = browser_view->multi_contents_view();
+  const bool split = multi && multi->GetVisible() && multi->IsInSplitView() &&
+                     !browser_view->IsFullscreen();
+  for (size_t i = 0; i < 2; ++i) {
+    const std::string page = "pane.html?" + base::NumberToString(i);
+    ContentsContainerView* container =
+        split && i < multi->contents_container_views().size()
+            ? multi->contents_container_views()[i]
+            : nullptr;
+    content::WebContents* contents =
+        container ? container->contents_view()->web_contents() : nullptr;
+    if (!contents) {
+      if (LogPoseSpotlightView* overlay = LogPoseFindOverlay(browser_view, page)) {
+        overlay->Hide();
+      }
+      continue;
+    }
+    const gfx::Rect area = views::View::ConvertRectToTarget(
+        container, browser_view, container->GetLocalBounds());
+    const gfx::Rect pill(area.right() - kWidth - 6, area.y() + 6, kWidth,
+                         kHeight);
+    const std::string mode =
+        "tab:" + base::NumberToString(
+                     sessions::SessionTabHelper::IdForTab(contents).id()) +
+        ":" + base::NumberToString(browser_view->browser()->GetSessionID().id());
+    LogPoseSpotlightView* overlay = LogPosePaneOverlay(browser_view, page);
+    if (overlay->GetVisible() && overlay->mode() == mode) {
+      overlay->SetBoundsRect(pill);
+    } else {
+      overlay->Show(mode, pill, /*focus=*/false);
+    }
+  }
+}
+
+std::string LogPoseDragTab(BrowserWindowInterface* browser,
+                         content::WebContents* sender,
+                         const gfx::Point& page_point,
+                         std::string_view zones) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !LogPoseOwnsWindow(browser_view)) {
+    return std::string();
+  }
+  views::WebView* page = sender ? LogPoseWebViewOf(browser_view, sender) : nullptr;
+  const gfx::Point point =
+      page ? views::View::ConvertPointToTarget(page, browser_view, page_point)
+           : page_point;
+  const gfx::Rect area = LogPoseContentsArea(browser_view);
+  std::string zone;
+  if (area.Contains(point) && !area.IsEmpty()) {
+    const double x = double(point.x() - area.x()) / area.width();
+    const double y = double(point.y() - area.y()) / area.height();
+    const std::pair<double, std::string_view> edges[] = {
+        {x, "left"}, {1 - x, "right"}, {y, "top"}, {1 - y, "bottom"}};
+    double nearest = 0.25;
+    for (const auto& [distance, name] : edges) {
+      if (distance < nearest && zones.find(name) != std::string_view::npos) {
+        nearest = distance;
+        zone = std::string(name);
+      }
+    }
+    if (zone.empty() && zones.find("join") != std::string_view::npos) {
+      zone = "join";
+    } else if (zone.empty() && zones.find("window") != std::string_view::npos) {
+      zone = "window";
+    }
+  }
+  LogPoseSpotlightView* overlay = LogPoseFindOverlay(browser_view, "drop.html");
+  if (zone.empty()) {
+    if (overlay) {
+      overlay->Hide();
+    }
+    return zone;
+  }
+  overlay = LogPoseOverlayFor(browser_view, "drop.html");
+  if (!overlay->GetVisible() || overlay->mode() != zone) {
+    overlay->Show(zone, area, /*focus=*/false);
+  } else {
+    overlay->SetBoundsRect(area);
+  }
+  return zone;
+}
+
+void LogPoseEndTabDrag(BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (LogPoseSpotlightView* overlay =
+          browser_view ? LogPoseFindOverlay(browser_view, "drop.html")
+                       : nullptr) {
+    overlay->Hide();
+  }
+}
