+ExtensionFunction::ResponseAction LogPosePrivateMediaActionFunction::Run() {
+  auto params = logpose_private::MediaAction::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/true, &contents) ||
+      !contents) {
+    return RespondNow(Error("No tab with that id."));
+  }
+  content::MediaSession* session = content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return RespondNow(Error("The tab has no media."));
+  }
+  using SuspendType = media_session::mojom::MediaSession::SuspendType;
+  const std::string& action = params->action;
+  if (action == "play") {
+    session->Resume(SuspendType::kUI);
+  } else if (action == "pause") {
+    session->Suspend(SuspendType::kUI);
+  } else if (action == "previous") {
+    session->PreviousTrack();
+  } else if (action == "next") {
+    session->NextTrack();
+  } else if (action == "pip") {
+    session->EnterPictureInPicture();
+  } else if (action == "exitPip") {
+    session->ExitPictureInPicture();
+  } else if (action == "seek" && params->seconds) {
+    session->SeekTo(base::Seconds(std::max(0.0, *params->seconds)));
+  } else {
+    return RespondNow(Error("Unknown media action."));
+  }
+  return RespondNow(NoArguments());
+}
