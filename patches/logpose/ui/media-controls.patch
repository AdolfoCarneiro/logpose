+ExtensionFunction::ResponseAction LogPosePrivateGetMediaSessionsFunction::Run() {
+  auto params = logpose_private::GetMediaSessions::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  using media_session::mojom::MediaSessionAction;
+  std::vector<logpose_private::MediaSessionState> sessions;
+  TabStripModel* model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    content::MediaSession* session = content::MediaSession::GetIfExists(contents);
+    if (!session) {
+      continue;
+    }
+    media_session::mojom::MediaSessionInfoPtr info =
+        session->GetMediaSessionInfoSync();
+    if (!info || !info->is_controllable ||
+        info->state ==
+            media_session::mojom::MediaSessionInfo::SessionState::kInactive) {
+      continue;
+    }
+    logpose_private::MediaSessionState entry;
+    entry.tab_id = ExtensionTabUtil::GetTabId(contents);
+    const media_session::MediaMetadata& metadata =
+        session->GetMediaSessionMetadata();
+    entry.title = base::UTF16ToUTF8(metadata.title);
+    entry.artist = base::UTF16ToUTF8(metadata.artist);
+    entry.album = base::UTF16ToUTF8(metadata.album);
+    entry.playing = info->playback_state ==
+                    media_session::mojom::MediaPlaybackState::kPlaying;
+    for (MediaSessionAction action : session->GetMediaSessionActionsSync()) {
+      switch (action) {
+        case MediaSessionAction::kPlay:
+          entry.actions.push_back("play");
+          break;
+        case MediaSessionAction::kPause:
+          entry.actions.push_back("pause");
+          break;
+        case MediaSessionAction::kPreviousTrack:
+          entry.actions.push_back("previous");
+          break;
+        case MediaSessionAction::kNextTrack:
+          entry.actions.push_back("next");
+          break;
+        case MediaSessionAction::kSeekTo:
+          entry.actions.push_back("seek");
+          break;
+        case MediaSessionAction::kEnterPictureInPicture:
+          entry.actions.push_back("pip");
+          break;
+        default:
+          break;
+      }
+    }
+    entry.duration = 0;
+    entry.position = 0;
+    entry.rate = 0;
+    if (std::optional<media_session::MediaPosition> position =
+            session->GetMediaSessionPosition()) {
+      const double duration = position->duration().InSecondsF();
+      if (std::isfinite(duration) && !position->duration().is_max()) {
+        entry.duration = duration;
+        entry.position = std::clamp(position->GetPosition().InSecondsF(), 0.0,
+                                    duration);
+        entry.rate = position->playback_rate();
+      }
+    }
+    sessions.push_back(std::move(entry));
+  }
+  return RespondNow(ArgumentList(
+      logpose_private::GetMediaSessions::Results::Create(sessions)));
+}
