+ExtensionFunction::ResponseAction LogposePrivateGetSearchEnginesFunction::Run() {
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(browser_context()));
+  if (!service) {
+    return RespondNow(Error("No search engines"));
+  }
+  service->Load();
+  const TemplateURL* current = service->GetDefaultSearchProvider();
+  std::vector<logpose_private::SearchEngine> engines;
+  for (const TemplateURL* engine : service->GetTemplateURLs()) {
+    if (engine->starter_pack_id() !=
+            template_url_starter_pack_data::StarterPackId::kNone ||
+        (engine != current &&
+         (!service->CanMakeDefault(engine) ||
+          (engine->prepopulate_id() <= 0 &&
+           engine->is_active() != TemplateURLData::ActiveStatus::kTrue)))) {
+      continue;
+    }
+    logpose_private::SearchEngine result;
+    result.id = engine->sync_guid();
+    result.name = base::UTF16ToUTF8(engine->short_name());
+    result.keyword = base::UTF16ToUTF8(engine->keyword());
+    if (engine->favicon_url().is_valid()) {
+      result.fav_icon_url = engine->favicon_url().spec();
+    }
+    result.is_default = engine == current;
+    engines.push_back(std::move(result));
+  }
+  return RespondNow(ArgumentList(
+      logpose_private::GetSearchEngines::Results::Create(engines)));
+}
+
+ExtensionFunction::ResponseAction
+LogposePrivateSetDefaultSearchEngineFunction::Run() {
+  auto params = logpose_private::SetDefaultSearchEngine::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(browser_context()));
+  TemplateURL* engine =
+      service ? service->GetTemplateURLForGUID(params->id) : nullptr;
+  if (!engine) {
+    return RespondNow(Error("Unknown search engine: " + params->id));
+  }
+  if (engine == service->GetDefaultSearchProvider()) {
+    return RespondNow(NoArguments());
+  }
+  if (!service->CanMakeDefault(engine)) {
+    return RespondNow(Error("Unknown search engine: " + params->id));
+  }
+  service->SetUserSelectedDefaultSearchProvider(
+      engine, search_engines::ChoiceMadeLocation::kSearchSettings);
+  return RespondNow(NoArguments());
+}
