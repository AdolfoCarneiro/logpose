+LogPoseColors ReadColors(const base::FilePath& dir) {
+  LogPoseColors colors;
+  std::string text;
+  if (base::ReadFileToString(dir.Append("frame-color"), &text)) {
+    colors.frame =
+        ParseColor(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  }
+  if (base::ReadFileToString(dir.Append("palette"), &text)) {
+    for (std::string_view line : base::SplitStringPiece(
+             text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const size_t space = line.find(' ');
+      if (space == std::string_view::npos) {
+        continue;
+      }
+      if (std::optional<SkColor> color = ParseColor(base::TrimWhitespaceASCII(
+              line.substr(space + 1), base::TRIM_ALL))) {
+        colors.palette.emplace(std::string(line.substr(0, space)), *color);
+      }
+    }
+  }
+  return colors;
 }
 
