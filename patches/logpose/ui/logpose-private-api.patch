+constexpr int kLogPosePopupAnchorId = 0x52414e47;
+
+views::View* LogPosePopupAnchorView(BrowserWindowInterface* browser) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "logpose-native-chrome") ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return nullptr;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return nullptr;
+  }
+  gfx::Rect bounds;
+  if (std::optional<gfx::Rect> anchor = LogPosePopupAnchor(browser)) {
+    bounds = *anchor;
+  } else {
+    gfx::Rect contents =
+        browser_view->contents_container()->GetBoundsInScreen();
+    bounds = gfx::Rect(contents.x() - 1, contents.y() + 8, 1, 1);
+  }
+  gfx::Point origin = bounds.origin();
+  views::View::ConvertPointFromScreen(browser_view, &origin);
+  bounds.set_origin(origin);
+  views::View* view = browser_view->GetViewByID(kLogPosePopupAnchorId);
+  if (!view) {
+    view = browser_view->AddChildView(std::make_unique<views::View>());
+    view->SetID(kLogPosePopupAnchorId);
+    view->SetCanProcessEventsWithinSubtree(false);
+  }
+  view->SetBoundsRect(bounds);
+  return view;
+}
