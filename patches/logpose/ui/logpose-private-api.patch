+#include "base/containers/flat_map.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "components/sessions/core/session_id.h"
+
+namespace {
+
+base::flat_map<SessionID::id_type, gfx::Rect>& Anchors() {
+  static base::NoDestructor<base::flat_map<SessionID::id_type, gfx::Rect>>
+      anchors;
+  return *anchors;
+}
+
+}  // namespace
+
+void LogPoseSetPopupAnchor(const BrowserWindowInterface* browser,
+                         const gfx::Rect& screen_bounds) {
+  Anchors()[browser->GetSessionID().id()] = screen_bounds;
+}
+
+std::optional<gfx::Rect> LogPosePopupAnchor(
+    const BrowserWindowInterface* browser) {
+  auto it = Anchors().find(browser->GetSessionID().id());
+  if (it == Anchors().end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
