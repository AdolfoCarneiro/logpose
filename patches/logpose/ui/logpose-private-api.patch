+namespace extensions {
+
+namespace {
+
+namespace logpose_private = api::logpose_private;
+
+constexpr int kIconSize = 28;
+constexpr float kIconScale = 2.0f;
+constexpr char kNoActionError[] = "No extension action with id *.";
+constexpr char kNoCommandError[] = "Unknown or disabled command *.";
+
+struct Command {
+  const char* name;
+  int id;
+};
+
+constexpr auto kCommands = std::to_array<Command>({
+    {"installPwa", IDC_INSTALL_PWA},
+    {"createShortcut", IDC_CREATE_SHORTCUT},
+    {"openInApp", IDC_OPEN_IN_PWA_WINDOW},
+    {"print", IDC_PRINT},
+    {"find", IDC_FIND},
+    {"zoomIn", IDC_ZOOM_PLUS},
+    {"zoomOut", IDC_ZOOM_MINUS},
+    {"zoomReset", IDC_ZOOM_NORMAL},
+    {"savePage", IDC_SAVE_PAGE},
+    {"viewSource", IDC_VIEW_SOURCE},
+    {"devTools", IDC_DEV_TOOLS},
+    {"taskManager", IDC_TASK_MANAGER},
+    {"clearBrowsingData", IDC_CLEAR_BROWSING_DATA},
+});
+
+BrowserWindowInterface* BrowserForWindow(ExtensionFunction* function,
+                                         int window_id,
+                                         std::string* error) {
+  WindowController* controller = ExtensionTabUtil::GetControllerInProfileWithId(
+      Profile::FromBrowserContext(function->browser_context()), window_id,
+      function->include_incognito_information(), error);
+  return controller ? controller->GetBrowserWindowInterface() : nullptr;
+}
+
+content::WebContents* ActiveContents(BrowserWindowInterface* browser) {
+  tabs::TabInterface* tab = TabListInterface::From(browser)->GetActiveTab();
+  return tab ? tab->GetContents() : nullptr;
+}
+
+std::string IconDataUrl(ToolbarActionViewModel* action,
+                        content::WebContents* contents) {
+  ui::ImageModel model =
+      action->GetIcon(contents, gfx::Size(kIconSize, kIconSize));
+  if (model.IsEmpty()) {
+    return std::string();
+  }
+  gfx::ImageSkia image = model.Rasterize(&contents->GetColorProvider());
+  std::optional<std::vector<uint8_t>> png = gfx::PNGCodec::EncodeBGRASkBitmap(
+      image.GetRepresentation(kIconScale).GetBitmap(),
+      /*discard_transparency=*/false);
+  if (!png) {
+    return std::string();
+  }
+  return "data:image/png;base64," + base::Base64Encode(*png);
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction
+LogPosePrivateGetExtensionActionsFunction::Run() {
+  auto params = logpose_private::GetExtensionActions::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  ExtensionsContainer* container = ExtensionsContainer::From(*browser);
+  content::WebContents* contents = ActiveContents(browser);
+  std::vector<logpose_private::ExtensionAction> actions;
+  if (container && contents) {
+    for (const auto& id :
+         ToolbarActionsModel::Get(browser->GetProfile())->action_ids()) {
+      ToolbarActionViewModel* action = container->GetActionForId(id);
+      if (!action) {
+        continue;
+      }
+      logpose_private::ExtensionAction entry;
+      entry.id = id;
+      entry.name = base::UTF16ToUTF8(action->GetActionName());
+      entry.icon = IconDataUrl(action, contents);
+      actions.push_back(std::move(entry));
+    }
+  }
+  return RespondNow(ArgumentList(
+      logpose_private::GetExtensionActions::Results::Create(actions)));
+}
+
+ExtensionFunction::ResponseAction
+LogPosePrivateRunExtensionActionFunction::Run() {
+  auto params = logpose_private::RunExtensionAction::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  ExtensionsContainer* container = ExtensionsContainer::From(*browser);
+  ToolbarActionViewModel* action =
+      container ? container->GetActionForId(params->id) : nullptr;
+  if (!action) {
+    return RespondNow(Error(kNoActionError, params->id));
+  }
+  if (content::WebContents* sender = GetSenderWebContents()) {
+    gfx::RectF anchor(params->anchor.x, params->anchor.y, params->anchor.width,
+                      params->anchor.height);
+    anchor.Offset(sender->GetContainerBounds().OffsetFromOrigin());
+    LogPoseSetPopupAnchor(browser, gfx::ToEnclosingRect(anchor));
+  }
+  action->ExecuteUserAction(
+      ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction
+LogPosePrivateGetEnabledCommandsFunction::Run() {
+  auto params = logpose_private::GetEnabledCommands::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  std::vector<std::string> enabled;
+  for (const Command& command : kCommands) {
+    if (chrome::IsCommandEnabled(browser, command.id)) {
+      enabled.push_back(command.name);
+    }
+  }
+  return RespondNow(ArgumentList(
+      logpose_private::GetEnabledCommands::Results::Create(enabled)));
+}
+
+ExtensionFunction::ResponseAction LogPosePrivateExecuteCommandFunction::Run() {
+  auto params = logpose_private::ExecuteCommand::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  for (const Command& command : kCommands) {
+    if (params->command == command.name &&
+        chrome::ExecuteCommand(browser, command.id)) {
+      return RespondNow(NoArguments());
+    }
+  }
+  return RespondNow(Error(kNoCommandError, params->command));
+}
+
