+// Copyright 2026 The Log Pose Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Use the <code>chrome.logposePrivate</code> API to give Log Pose's sidebar what
+// the native toolbar and app menu did: the extensions' actions and the
+// browser's own commands. Only Log Pose's sidebar may use it.
+namespace logposePrivate {
+  // An extension's action, as the toolbar would show it on the active tab.
+  dictionary ExtensionAction {
+    DOMString id;
+    DOMString name;
+    // The action's icon with its badge, as a PNG data URL.
+    DOMString icon;
+  };
+
+  // Where the action was clicked, in the calling page's CSS pixels.
+  dictionary Anchor {
+    double x;
+    double y;
+    double width;
+    double height;
+  };
+
+  callback ExtensionActionsCallback = void(ExtensionAction[] actions);
+  callback CommandsCallback = void(DOMString[] commands);
+  callback DoneCallback = void();
+
+  interface Functions {
+    // The extensions with an action.
+    static void getExtensionActions(
+        long windowId,
+        ExtensionActionsCallback callback);
+
+    // Runs an extension's action as a click on its toolbar button would: its
+    // popup opens next to <code>anchor</code>.
+    static void runExtensionAction(
+        long windowId,
+        DOMString id,
+        Anchor anchor,
+        optional DoneCallback callback);
+
+    // The browser commands (see executeCommand) the window can run now.
+    static void getEnabledCommands(
+        long windowId,
+        CommandsCallback callback);
+
+    // Runs a browser command in the window: installPwa, createShortcut,
+    // openInApp, print, find, zoomIn, zoomOut, zoomReset, savePage,
+    // viewSource, devTools, taskManager or clearBrowsingData.
+    static void executeCommand(
+        long windowId,
+        DOMString command,
+        optional DoneCallback callback);
+  };
+};
