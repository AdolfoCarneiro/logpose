 namespace {
 
+bool LogPoseCaptionButtons() {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "logpose-native-chrome");
+}
+
+// Botões da janela do Log Pose como os do tema Utterly Round do KWin: bolinhas
+// laranja, verde e vermelha, com o símbolo ao passar o mouse, e cinza-claras
+// com a janela inativa.
+class LogPoseCaptionButton : public views::FrameCaptionButton {
+ public:
+  using views::FrameCaptionButton::FrameCaptionButton;
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const bool hot = GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    SkColor color;
+    switch (GetIcon()) {
+      case views::CAPTION_BUTTON_ICON_MINIMIZE:
+        color = SkColorSetRGB(0xf6, 0x74, 0x00);
+        break;
+      case views::CAPTION_BUTTON_ICON_CLOSE:
+        color = SkColorSetRGB(0xff, 0x2a, 0x2a);
+        break;
+      default:
+        color = SkColorSetRGB(0x27, 0xae, 0x60);
+        break;
+    }
+    if (!GetPaintAsActive() && !hot) {
+      color = SkColorSetRGB(0xef, 0xf0, 0xf1);
+    }
+    const gfx::PointF center = gfx::RectF(GetContentsBounds()).CenterPoint();
+    cc::PaintFlags dot;
+    dot.setAntiAlias(true);
+    dot.setColor(color);
+    canvas->DrawCircle(center, 7.5f, dot);
+    if (!hot) {
+      return;
+    }
+    cc::PaintFlags glyph;
+    glyph.setAntiAlias(true);
+    glyph.setColor(SkColorSetARGB(0xf0, 0xff, 0xff, 0xff));
+    glyph.setStyle(cc::PaintFlags::kStroke_Style);
+    glyph.setStrokeWidth(1.6f);
+    glyph.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    constexpr float d = 3.2f;
+    switch (GetIcon()) {
+      case views::CAPTION_BUTTON_ICON_MINIMIZE:
+        canvas->DrawLine(center + gfx::Vector2dF(-d, 0),
+                         center + gfx::Vector2dF(d, 0), glyph);
+        break;
+      case views::CAPTION_BUTTON_ICON_CLOSE:
+        canvas->DrawLine(center + gfx::Vector2dF(-d, -d),
+                         center + gfx::Vector2dF(d, d), glyph);
+        canvas->DrawLine(center + gfx::Vector2dF(-d, d),
+                         center + gfx::Vector2dF(d, -d), glyph);
+        break;
+      default:
+        canvas->DrawRect(gfx::RectF(center.x() - d, center.y() - d, 2 * d,
+                                    2 * d),
+                         glyph);
+        break;
+    }
+  }
+};
+
