+bool LogPoseCaptionButtons() {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "logpose-native-chrome");
+}
+
+// Botões da janela do Log Pose como os do tema Utterly Round do KWin com o
+// esquema de cores do sistema: bolinhas nas cores neutra, positiva e negativa,
+// com o símbolo do tema ao passar o mouse e da cor do fundo dos botões, que
+// também pinta as bolinhas com a janela inativa. Os símbolos são os caminhos
+// dos SVGs do tema, no círculo de raio 1 centrado na origem.
+void LogPoseMaximizeGlyph(SkPathBuilder& p) {
+  p.moveTo(-0.2674f, -0.5000f);
+  p.lineTo(0.3504f, -0.5000f);
+  p.cubicTo(0.4327f, -0.5000f, 0.5000f, -0.4333f, 0.5000f, -0.3517f);
+  p.lineTo(0.5000f, 0.2608f);
+  p.close();
+  p.moveTo(0.2698f, 0.5000f);
+  p.lineTo(-0.3504f, 0.5000f);
+  p.cubicTo(-0.4327f, 0.5000f, -0.5000f, 0.4333f, -0.5000f, 0.3517f);
+  p.lineTo(-0.5000f, -0.2633f);
+  p.lineTo(0.2698f, 0.5000f);
+}
+void LogPoseRestoreGlyph(SkPathBuilder& p) {
+  p.moveTo(0.0338f, -0.8000f);
+  p.lineTo(0.0338f, -0.1833f);
+  p.cubicTo(0.0338f, -0.0956f, 0.1064f, 0.0116f, 0.1934f, 0.0116f);
+  p.lineTo(0.8000f, 0.0116f);
+  p.close();
+  p.moveTo(-0.0238f, 0.1833f);
+  p.cubicTo(-0.0238f, 0.0955f, -0.0999f, 0.0304f, -0.1834f, 0.0251f);
+  p.lineTo(-0.8000f, 0.0251f);
+  p.lineTo(-0.0238f, 0.8000f);
+  p.close();
+}
+void LogPoseCloseGlyph(SkPathBuilder& p) {
+  p.moveTo(-0.4758f, 0.3571f);
+  p.lineTo(0.3571f, -0.4758f);
+  p.cubicTo(0.3893f, -0.5081f, 0.4420f, -0.5081f, 0.4743f, -0.4758f);
+  p.lineTo(0.4758f, -0.4743f);
+  p.cubicTo(0.5081f, -0.4420f, 0.5081f, -0.3893f, 0.4758f, -0.3571f);
+  p.lineTo(-0.3571f, 0.4758f);
+  p.cubicTo(-0.3893f, 0.5081f, -0.4420f, 0.5081f, -0.4743f, 0.4758f);
+  p.lineTo(-0.4758f, 0.4743f);
+  p.cubicTo(-0.5081f, 0.4420f, -0.5081f, 0.3893f, -0.4758f, 0.3571f);
+  p.close();
+  p.moveTo(-0.3571f, -0.4758f);
+  p.lineTo(0.4758f, 0.3571f);
+  p.cubicTo(0.5080f, 0.3893f, 0.5080f, 0.4420f, 0.4758f, 0.4743f);
+  p.lineTo(0.4743f, 0.4758f);
+  p.cubicTo(0.4420f, 0.5081f, 0.3893f, 0.5081f, 0.3571f, 0.4758f);
+  p.lineTo(-0.4758f, -0.3571f);
+  p.cubicTo(-0.5081f, -0.3893f, -0.5081f, -0.4420f, -0.4758f, -0.4743f);
+  p.lineTo(-0.4743f, -0.4758f);
+  p.cubicTo(-0.4420f, -0.5081f, -0.3893f, -0.5081f, -0.3571f, -0.4758f);
+  p.close();
+}
