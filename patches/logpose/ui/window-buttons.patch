+class LogPoseCaptionButton : public views::FrameCaptionButton {
+ public:
+  LogPoseCaptionButton(views::CaptionButtonIcon icon, int ht, bool restore)
+      : views::FrameCaptionButton(views::Button::PressedCallback(), icon, ht),
+        restore_(restore) {}
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    constexpr float kRadius = 7.5f;
+    constexpr SkColor kButtonBackground = SkColorSetRGB(0x00, 0x00, 0x00);
+    const bool hot = GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    SkColor color;
+    switch (GetIcon()) {
+      case views::CAPTION_BUTTON_ICON_MINIMIZE:
+        color = SkColorSetRGB(0xf6, 0x74, 0x00);
+        break;
+      case views::CAPTION_BUTTON_ICON_CLOSE:
+        color = SkColorSetRGB(0xda, 0x44, 0x53);
+        break;
+      default:
+        color = SkColorSetRGB(0x27, 0xae, 0x60);
+        break;
+    }
+    if (!GetPaintAsActive() && !hot) {
+      color = kButtonBackground;
+    }
+    const gfx::PointF center = gfx::RectF(GetContentsBounds()).CenterPoint();
+    cc::PaintFlags dot;
+    dot.setAntiAlias(true);
+    dot.setColor(color);
+    canvas->DrawCircle(center, kRadius, dot);
+    if (!hot) {
+      return;
+    }
+    cc::PaintFlags glyph;
+    glyph.setAntiAlias(true);
+    glyph.setColor(kButtonBackground);
+    if (GetIcon() == views::CAPTION_BUTTON_ICON_MINIMIZE) {
+      glyph.setStyle(cc::PaintFlags::kStroke_Style);
+      glyph.setStrokeWidth(0.2654f * kRadius);
+      glyph.setStrokeCap(cc::PaintFlags::kRound_Cap);
+      canvas->DrawLine(center + gfx::Vector2dF(-0.5673f * kRadius, 0),
+                       center + gfx::Vector2dF(0.5673f * kRadius, 0), glyph);
+      return;
+    }
+    SkPathBuilder builder;
+    if (GetIcon() == views::CAPTION_BUTTON_ICON_CLOSE) {
+      LogPoseCloseGlyph(builder);
+    } else if (restore_) {
+      LogPoseRestoreGlyph(builder);
+    } else {
+      LogPoseMaximizeGlyph(builder);
+    }
+    SkMatrix matrix = SkMatrix::Scale(kRadius, kRadius);
+    matrix.postTranslate(center.x(), center.y());
+    canvas->DrawPath(builder.detach(&matrix), glyph);
+  }
+
+ private:
+  const bool restore_;
+};
