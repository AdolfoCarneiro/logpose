+// The container of a tab, kept with the tab in the session so that session
+// restore and reopening a closed tab bring it back in it.
+inline constexpr char kLogPoseContainerExtraDataKey[] = "logpose_container";
+
+inline scoped_refptr<content::SiteInstance> LogPoseContainerSiteInstance(
+    content::BrowserContext* context,
+    const std::string& name,
+    const GURL& url) {
+  if (name.empty()) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      context, url, LogPoseContainerPartition(context, name));
+}
+
 inline base::FilePath LogPoseContainerPartitionsPath() {
