+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/ext_background_effect.h"
+
+#include <ext-background-effect-v1-client-protocol.h>
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/logging.h"
+#include "base/numerics/safe_conversions.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+
+namespace ui {
+
+namespace {
+constexpr uint32_t kVersion = 1;
+}  // namespace
+
+constexpr char ExtBackgroundEffectManager::kInterfaceName[];
+
+void ExtBackgroundEffectManager::Instantiate(WaylandConnection* connection,
+                                             wl_registry* registry,
+                                             uint32_t name,
+                                             const std::string& interface,
+                                             uint32_t version) {
+  CHECK_EQ(interface, kInterfaceName) << "Expected \"" << kInterfaceName
+                                      << "\" but got \"" << interface << "\"";
+
+  if (connection->ext_background_effect_manager_ ||
+      !wl::CanBind(interface, version, kVersion, kVersion)) {
+    return;
+  }
+
+  auto manager =
+      wl::Bind<ext_background_effect_manager_v1>(registry, name, kVersion);
+  if (!manager) {
+    LOG(ERROR) << "Failed to bind to ext_background_effect_manager_v1 global";
+    return;
+  }
+  connection->ext_background_effect_manager_ =
+      std::make_unique<ExtBackgroundEffectManager>(manager.release(),
+                                                   connection);
+}
+
+ExtBackgroundEffectManager::ExtBackgroundEffectManager(
+    ext_background_effect_manager_v1* manager,
+    WaylandConnection* connection)
+    : manager_(manager), connection_(connection) {}
+
+ExtBackgroundEffectManager::~ExtBackgroundEffectManager() = default;
+
+std::unique_ptr<ExtBackgroundEffectSurface> ExtBackgroundEffectManager::Create(
+    wl_surface* surface) {
+  return std::make_unique<ExtBackgroundEffectSurface>(
+      ext_background_effect_manager_v1_get_background_effect(manager_.get(),
+                                                             surface),
+      connection_);
+}
+
+ExtBackgroundEffectSurface::ExtBackgroundEffectSurface(
+    ext_background_effect_surface_v1* effect,
+    WaylandConnection* connection)
+    : effect_(effect), connection_(connection) {}
+
+ExtBackgroundEffectSurface::~ExtBackgroundEffectSurface() = default;
+
+void ExtBackgroundEffectSurface::SetBlurRegion(const gfx::Rect& rect) {
+  if (rect == region_) {
+    return;
+  }
+  region_ = rect;
+  wl::Object<wl_region> region(
+      wl_compositor_create_region(connection_->compositor()));
+  // Log Pose: cantos arredondados como os que o KWin (Rounded Corners) recorta
+  // na janela, em faixas de 1 px; com o retângulo, o blur sobrava nas quinas.
+  constexpr int kCornerRadius = 10;
+  const int radius =
+      std::min({kCornerRadius, rect.width() / 2, rect.height() / 2});
+  wl_region_add(region.get(), rect.x(), rect.y() + radius, rect.width(),
+                rect.height() - 2 * radius);
+  for (int row = 0; row < radius; ++row) {
+    const float dy = radius - row - 0.5f;
+    const int inset = base::ClampCeil(
+        radius - std::sqrt(static_cast<float>(radius * radius) - dy * dy));
+    const int width = rect.width() - 2 * inset;
+    wl_region_add(region.get(), rect.x() + inset, rect.y() + row, width, 1);
+    wl_region_add(region.get(), rect.x() + inset, rect.bottom() - 1 - row,
+                  width, 1);
+  }
+  ext_background_effect_surface_v1_set_blur_region(effect_.get(), region.get());
+}
+
+}  // namespace ui
