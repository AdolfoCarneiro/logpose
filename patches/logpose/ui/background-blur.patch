+
+namespace ui {
+
+class WaylandConnection;
+
+// Blur behind a surface, applied by the compositor on the surface's next
+// commit.
+class ExtBackgroundEffectSurface {
+ public:
+  ExtBackgroundEffectSurface(ext_background_effect_surface_v1* effect,
+                             WaylandConnection* connection);
+  ExtBackgroundEffectSurface(const ExtBackgroundEffectSurface&) = delete;
+  ExtBackgroundEffectSurface& operator=(const ExtBackgroundEffectSurface&) =
+      delete;
+  ~ExtBackgroundEffectSurface();
+
+  // Blurs what is behind |rect|, in surface coordinates.
+  void SetBlurRegion(const gfx::Rect& rect);
+
+ private:
+  wl::Object<ext_background_effect_surface_v1> effect_;
+  const raw_ptr<WaylandConnection> connection_;
+  gfx::Rect region_;
+};
+
+// Wraps the background effect manager, which is provided via
+// ext_background_effect_manager_v1 interface.
+class ExtBackgroundEffectManager
+    : public wl::GlobalObjectRegistrar<ExtBackgroundEffectManager> {
+ public:
+  static constexpr const char kInterfaceName[] =
+      "ext_background_effect_manager_v1";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  ExtBackgroundEffectManager(ext_background_effect_manager_v1* manager,
+                             WaylandConnection* connection);
+  ExtBackgroundEffectManager(const ExtBackgroundEffectManager&) = delete;
+  ExtBackgroundEffectManager& operator=(const ExtBackgroundEffectManager&) =
+      delete;
+  ~ExtBackgroundEffectManager();
+
+  std::unique_ptr<ExtBackgroundEffectSurface> Create(wl_surface* surface);
+
+ private:
+  wl::Object<ext_background_effect_manager_v1> manager_;
+
+  const raw_ptr<WaylandConnection> connection_;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_EXT_BACKGROUND_EFFECT_H_
