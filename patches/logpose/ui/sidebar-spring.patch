+double LogPoseSidebarReveal(const BrowserWindowInterface* browser) {
+  auto it = Springs().find(browser->GetSessionID().id());
+  if (it != Springs().end()) {
+    return it->second->value();
+  }
+  return LogPoseGetSidebarMode(browser) == LogPoseSidebarMode::kCollapsed ? 0 : 1;
+}
