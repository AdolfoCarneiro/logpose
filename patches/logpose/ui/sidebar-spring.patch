+class RevealSpring {
+ public:
+  RevealSpring(BrowserWindowInterface* browser, double value)
+      : browser_(browser), value_(value), target_(value) {}
+  RevealSpring(const RevealSpring&) = delete;
+  RevealSpring& operator=(const RevealSpring&) = delete;
+
+  double value() const { return value_; }
+
+  void SetTarget(double target) {
+    target_ = target;
+    if (timer_.IsRunning()) {
+      return;
+    }
+    last_ = base::TimeTicks::Now();
+    timer_.Start(FROM_HERE, base::Milliseconds(16),
+                 base::BindRepeating(&RevealSpring::Tick,
+                                     base::Unretained(this)));
+  }
+
+ private:
+  static constexpr double kStiffness = 320;
+  static constexpr double kDamping = 19;
+  static constexpr double kStep = 0.002;
+
+  void Tick() {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    double left = std::min((now - last_).InSecondsF(), 0.05);
+    last_ = now;
+    while (left > 0) {
+      const double step = std::min(left, kStep);
+      velocity_ +=
+          (-kStiffness * (value_ - target_) - kDamping * velocity_) * step;
+      value_ += velocity_ * step;
+      left -= step;
+    }
+    if (std::abs(value_ - target_) < 0.001 && std::abs(velocity_) < 0.01) {
+      value_ = target_;
+      velocity_ = 0;
+      timer_.Stop();
+    }
+    if (BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser_)) {
+      view->InvalidateLayout();
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  double value_;
+  double target_;
+  double velocity_ = 0;
+  base::TimeTicks last_;
+  base::RepeatingTimer timer_;
+};
+
+base::flat_map<SessionID::id_type, std::unique_ptr<RevealSpring>>& Springs() {
+  static base::NoDestructor<
+      base::flat_map<SessionID::id_type, std::unique_ptr<RevealSpring>>>
+      springs;
+  return *springs;
+}
