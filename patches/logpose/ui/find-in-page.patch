+ExtensionFunction::ResponseAction LogposePrivateFindFunction::Run() {
+  auto params = logpose_private::Find::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  content::WebContents* contents = ActiveContents(browser);
+  auto* helper =
+      contents ? find_in_page::FindTabHelper::FromWebContents(contents)
+               : nullptr;
+  if (!helper) {
+    return RespondNow(Error("The active tab can't be searched."));
+  }
+  if (params->text.empty()) {
+    helper->StopFinding(find_in_page::SelectionAction::kClear);
+    return RespondNow(ArgumentList(logpose_private::Find::Results::Create(
+        logpose_private::FindResult())));
+  }
+  observation_.Observe(helper);
+  AddRef();
+  helper->StartFinding(base::UTF8ToUTF16(params->text), params->forward,
+                       params->match_case, /*find_match=*/true);
+  return RespondLater();
+}
+
+void LogposePrivateFindFunction::OnFindResultAvailable(
+    content::WebContents* web_contents) {
+  const find_in_page::FindNotificationDetails& details =
+      observation_.GetSource()->find_result();
+  if (!details.final_update()) {
+    return;
+  }
+  Finish(details.number_of_matches(), details.active_match_ordinal());
+}
+
+void LogposePrivateFindFunction::OnFindEmptyText(
+    content::WebContents* web_contents) {
+  Finish(0, 0);
+}
+
+void LogposePrivateFindFunction::OnFindTabHelperDestroyed(
+    find_in_page::FindTabHelper* helper) {
+  Finish(0, 0);
+}
+
+void LogposePrivateFindFunction::Finish(int matches, int active) {
+  if (!observation_.IsObserving()) {
+    return;
+  }
+  observation_.Reset();
+  logpose_private::FindResult result;
+  result.matches = std::max(matches, 0);
+  result.active = std::max(active, 0);
+  Respond(ArgumentList(logpose_private::Find::Results::Create(result)));
+  Release();
+}
+
+ExtensionFunction::ResponseAction LogposePrivateStopFindingFunction::Run() {
+  auto params = logpose_private::StopFinding::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  content::WebContents* contents = ActiveContents(browser);
+  if (auto* helper =
+          contents ? find_in_page::FindTabHelper::FromWebContents(contents)
+                   : nullptr) {
+    helper->StopFinding(find_in_page::SelectionAction::kKeep);
+  }
+  return RespondNow(NoArguments());
 }
 
