+LogPoseSpotlightView* LogPoseOverlayFor(BrowserView* browser_view,
+                                    std::string_view page) {
+  LogPoseSpotlightView* overlay = nullptr;
+  for (views::View* child : browser_view->children()) {
+    if (auto* found = views::AsViewClass<LogPoseSpotlightView>(child);
+        found && found->page() == page) {
+      overlay = found;
+    }
+  }
+  if (!overlay) {
+    overlay = browser_view->AddChildView(std::make_unique<LogPoseSpotlightView>(
+        browser_view->browser()->GetProfile(), std::string(page),
+        base::BindRepeating(
+            [](BrowserView* view) {
+              if (views::WebView* contents = view->GetActiveContentsWebView()) {
+                contents->RequestFocus();
+              }
+            },
+            base::Unretained(browser_view))));
+  }
+  browser_view->ReorderChildView(overlay, browser_view->children().size());
+  return overlay;
+}
+
+bool LogPoseShowFind(BrowserWindowInterface* browser, int step) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "logpose-native-chrome") ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  views::WebView* contents =
+      browser_view ? browser_view->GetActiveContentsWebView() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  constexpr int kWidth = 440;
+  constexpr int kHeight = 84;
+  const gfx::Rect area = views::View::ConvertRectToTarget(
+      contents, browser_view, contents->GetLocalBounds());
+  const gfx::Rect card(area.right() - kWidth - 4, area.y() + 4, kWidth,
+                       kHeight);
+  LogPoseOverlayFor(browser_view, "find.html")
+      ->Show(step == 0 ? "open" : step > 0 ? "next" : "previous", card);
+  return true;
+}
