+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_ORG_KDE_KWIN_BLUR_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_ORG_KDE_KWIN_BLUR_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+
+namespace ui {
+
+class WaylandConnection;
+
+// Blur behind a surface, applied by KWin on the surface's next commit.
+class OrgKdeKwinBlur {
+ public:
+  OrgKdeKwinBlur(org_kde_kwin_blur* blur, WaylandConnection* connection);
+  OrgKdeKwinBlur(const OrgKdeKwinBlur&) = delete;
+  OrgKdeKwinBlur& operator=(const OrgKdeKwinBlur&) = delete;
+  ~OrgKdeKwinBlur();
+
+  // Blurs what is behind |rect|, in surface coordinates.
+  void SetRegion(const gfx::Rect& rect);
+
+ private:
+  wl::Object<org_kde_kwin_blur> blur_;
+  const raw_ptr<WaylandConnection> connection_;
+  gfx::Rect region_;
+};
+
+// Wraps the KDE Wayland blur manager, which is provided via
+// org_kde_kwin_blur_manager interface.
+class OrgKdeKwinBlurManager
+    : public wl::GlobalObjectRegistrar<OrgKdeKwinBlurManager> {
+ public:
+  static constexpr const char kInterfaceName[] = "org_kde_kwin_blur_manager";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  OrgKdeKwinBlurManager(org_kde_kwin_blur_manager* manager,
+                        WaylandConnection* connection);
+  OrgKdeKwinBlurManager(const OrgKdeKwinBlurManager&) = delete;
+  OrgKdeKwinBlurManager& operator=(const OrgKdeKwinBlurManager&) = delete;
+  ~OrgKdeKwinBlurManager();
+
+  std::unique_ptr<OrgKdeKwinBlur> Create(wl_surface* surface);
+
+ private:
+  wl::Object<org_kde_kwin_blur_manager> manager_;
+
+  const raw_ptr<WaylandConnection> connection_;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_ORG_KDE_KWIN_BLUR_H_
