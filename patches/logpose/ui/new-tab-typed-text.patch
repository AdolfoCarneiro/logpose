+// O pré-carregamento feito com a janela abrindo pega a extensão ainda não
+// pronta e cai numa página de erro; aí o primeiro Show() recarregava a página e
+// as teclas apertadas nesse meio-tempo se perdiam (o Spotlight aberto pela nova
+// aba comia letras). Escondida e com erro, a página tenta de novo.
+void LogPoseSpotlightView::DidFinishLoad(
+    content::RenderFrameHost* render_frame_host,
+    const GURL& validated_url) {
+  if (!render_frame_host->IsInPrimaryMainFrame() || GetVisible() ||
+      !validated_url.SchemeIs(content::kChromeErrorScheme) ||
+      preload_retries_ >= 20) {
+    return;
+  }
+  ++preload_retries_;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<LogPoseSpotlightView> view) {
+            if (!view || view->GetVisible()) {
+              return;
+            }
+            content::NavigationController::LoadURLParams params(GURL(
+                std::string(
+                    "chrome-extension://hncljkmljckjojdjincglklbdihcaeko/") +
+                view->page() + "#idle-0"));
+            params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+            params.should_replace_current_entry = true;
+            view->GetWebContents()->GetController().LoadURLWithParams(params);
+          },
+          weak_factory_.GetWeakPtr()),
+      base::Milliseconds(500));
+}
