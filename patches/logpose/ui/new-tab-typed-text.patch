+// Do Ctrl+T até a página da aba nova ficar pronta passam uns 150 ms em que as
+// teclas iam pra aba anterior e se perdiam. Nesse meio-tempo elas ficam
+// guardadas aqui e a nova aba pega com takeTypedText.
+class LogPoseTypeAhead : public ui::EventHandler, public aura::WindowObserver {
+ public:
+  LogPoseTypeAhead() = default;
+  ~LogPoseTypeAhead() override { Stop(); }
+
+  void Start(aura::Window* window) {
+    Stop();
+    typed_.clear();
+    if (!window) {
+      return;
+    }
+    window_ = window;
+    window_->AddPreTargetHandler(this);
+    observation_.Observe(window_);
+    timer_.Start(FROM_HERE, base::Milliseconds(1500),
+                 base::BindOnce(&LogPoseTypeAhead::Stop,
+                                base::Unretained(this)));
+  }
+
+  std::u16string Take() {
+    Stop();
+    std::u16string typed;
+    typed.swap(typed_);
+    return typed;
+  }
+
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    if (event->type() != ui::EventType::kKeyPressed) {
+      return;
+    }
+    if (event->flags() &
+        (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN)) {
+      Stop();
+      return;
+    }
+    switch (event->key_code()) {
+      case ui::VKEY_ESCAPE:
+        Stop();
+        return;
+      case ui::VKEY_RETURN:
+        if (!typed_.empty() && typed_.back() != u'\n') {
+          typed_.push_back(u'\n');
+        }
+        event->StopPropagation();
+        return;
+      case ui::VKEY_BACK:
+        if (!typed_.empty() && typed_.back() != u'\n') {
+          typed_.pop_back();
+        }
+        event->StopPropagation();
+        return;
+      default:
+        break;
+    }
+    const char16_t character = event->GetCharacter();
+    if (character < 0x20 || character == 0x7f ||
+        (!typed_.empty() && typed_.back() == u'\n')) {
+      return;
+    }
+    typed_.push_back(character);
+    event->StopPropagation();
+  }
+
+  void OnWindowDestroying(aura::Window* window) override { Stop(); }
+
+ private:
+  void Stop() {
+    timer_.Stop();
+    observation_.Reset();
+    if (window_) {
+      window_->RemovePreTargetHandler(this);
+      window_ = nullptr;
+    }
+  }
+
+  raw_ptr<aura::Window> window_ = nullptr;
+  std::u16string typed_;
+  base::OneShotTimer timer_;
+  base::ScopedObservation<aura::Window, aura::WindowObserver> observation_{
+      this};
+};
