+#include "chrome/browser/ui/color/ranga_color_mixer.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+#include "ui/color/color_transform.h"
+#include "ui/native_theme/native_theme.h"
+
+namespace {
+
+base::FilePath FrameColorPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> state = env->GetVar("XDG_STATE_HOME");
+  base::FilePath dir = state && !state->empty()
+                           ? base::FilePath(*state)
+                           : base::GetHomeDir().Append(".local/state");
+  return dir.Append("ranga").Append("frame-color");
+}
+
+std::optional<SkColor> ReadFrameColor(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToString(path, &text)) {
+    return std::nullopt;
+  }
+  std::string_view hex = base::TrimWhitespaceASCII(text, base::TRIM_ALL);
+  uint32_t value = 0;
+  if ((hex.size() != 7 && hex.size() != 9) || hex[0] != '#' ||
+      !base::HexStringToUInt(hex.substr(1), &value)) {
+    return std::nullopt;
+  }
+  if (hex.size() == 7) {
+    value = (value << 8) | 0xff;
+  }
+  return SkColorSetARGB(value & 0xff, (value >> 24) & 0xff,
+                        (value >> 16) & 0xff, (value >> 8) & 0xff);
+}
+
+class RangaFrameColor {
+ public:
+  static RangaFrameColor& Get() {
+    static base::NoDestructor<RangaFrameColor> instance;
+    return *instance;
+  }
+
+  std::optional<SkColor> color() const { return color_; }
+
+  void EnsureWatching() {
+    if (timer_.IsRunning()) {
+      return;
+    }
+    timer_.Start(FROM_HERE, base::Milliseconds(500),
+                 base::BindRepeating(&RangaFrameColor::Poll,
+                                     base::Unretained(this)));
+    Poll();
+  }
+
+ private:
+  void Poll() {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadFrameColor, path_),
+        base::BindOnce(&RangaFrameColor::OnRead, base::Unretained(this)));
+  }
+
+  void OnRead(std::optional<SkColor> color) {
+    if (color == color_) {
+      return;
+    }
+    color_ = color;
+    ui::NativeTheme::GetInstanceForNativeUi()->NotifyOnNativeThemeUpdated();
+  }
+
+  const base::FilePath path_ = FrameColorPath();
+  std::optional<SkColor> color_;
+  base::RepeatingTimer timer_;
+};
+
+}  // namespace
+
+void AddRangaColorMixer(ui::ColorProvider* provider,
+                        const ui::ColorProviderKey& key) {
+  RangaFrameColor& frame = RangaFrameColor::Get();
+  frame.EnsureWatching();
+  if (!frame.color() || key.app_controller) {
+    return;
+  }
+  const SkColor color = SkColorSetA(*frame.color(), SK_AlphaOPAQUE);
+  ui::ColorMixer& mixer = provider->AddMixer();
+  const ui::ColorId ids[] = {ui::kColorFrameActive, ui::kColorFrameInactive,
+                             kColorToolbar, kColorSidePanelContentBackground,
+                             kColorSidePanelContentAreaSeparator};
+  for (ui::ColorId id : ids) {
+    mixer[id] = ui::ColorTransform(color);
+  }
+}
+
+SkColor RangaMaterialColor(SkColor color) {
+  const std::optional<SkColor> frame = RangaFrameColor::Get().color();
+  return frame ? SkColorSetA(color, SkColorGetA(*frame)) : color;
+}
