+ExtensionFunction::ResponseAction RangaPrivateResolveInputFunction::Run() {
+  auto params = ranga_private::ResolveInput::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  Profile* profile = browser->GetProfile();
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(profile)->Classify(
+      AutocompleteMatch::SanitizeString(base::UTF8ToUTF16(params->text)),
+      /*in_keyword_mode=*/false, /*allow_exact_keyword_match=*/true,
+      metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) {
+    return RespondNow(Error(kBadInputError, params->text));
+  }
+  ranga_private::ResolvedInput input;
+  input.url = match.destination_url.spec();
+  input.kind = AutocompleteMatch::IsSearchType(match.type) ? "search" : "url";
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  const TemplateURL* engine =
+      service &&
+              match.type == omnibox::AutocompleteMatchType::kSearchOtherEngine
+          ? match.GetTemplateURL(service)
+          : nullptr;
+  if (engine && engine != service->GetDefaultSearchProvider()) {
+    input.kind = "keyword";
+    input.engine = base::UTF16ToUTF8(engine->short_name());
+    input.query = base::UTF16ToUTF8(match.contents);
+  }
+  return RespondNow(
+      ArgumentList(ranga_private::ResolveInput::Results::Create(input)));
+}
