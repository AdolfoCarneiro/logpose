+void RangaSpotlightView::Preload() {
+  content::WebContents* contents = GetWebContents();
+  if (!contents->GetController().IsInitialNavigation()) {
+    return;
+  }
+  contents->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+  contents->GetController().LoadURL(
+      GURL(std::string("chrome-extension://hncljkmljckjojdjincglklbdihcaeko/") +
+           page_ + "#idle-0"),
+      content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
 }
 
