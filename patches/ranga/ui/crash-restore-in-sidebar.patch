+ExtensionFunction::ResponseAction RangaPrivateGetCrashedSessionFunction::Run() {
+  auto params = ranga_private::GetCrashedSession::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(
+      ArgumentList(ranga_private::GetCrashedSession::Results::Create(
+          RangaHasCrashedSession(browser))));
+}
+
+ExtensionFunction::ResponseAction
+RangaPrivateResolveCrashedSessionFunction::Run() {
+  auto params = ranga_private::ResolveCrashedSession::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  RangaResolveCrashedSession(browser, params->restore);
+  return RespondNow(NoArguments());
+}
