+// Copyright 2026 The Ranga Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/extensions/ranga_crashed_session.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/callback_list.h"
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/sessions/exit_type_service.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "components/sessions/core/session_id.h"
+
+namespace {
+
+struct Offer {
+  std::unique_ptr<ExitTypeService::CrashedLock> lock;
+  base::CallbackListSubscription closed;
+};
+
+base::flat_map<SessionID::id_type, Offer>& Offers() {
+  static base::NoDestructor<base::flat_map<SessionID::id_type, Offer>> offers;
+  return *offers;
+}
+
+}  // namespace
+
+void RangaOfferCrashedSession(BrowserWindowInterface* browser) {
+  ExitTypeService* service =
+      ExitTypeService::GetInstanceForProfile(browser->GetProfile());
+  Offer& offer = Offers()[browser->GetSessionID().id()];
+  offer.lock = service ? service->CreateCrashedLock() : nullptr;
+  offer.closed = browser->RegisterBrowserDidClose(
+      base::BindRepeating([](BrowserWindowInterface* closed) {
+        Offers().erase(closed->GetSessionID().id());
+      }));
+}
+
+bool RangaHasCrashedSession(const BrowserWindowInterface* browser) {
+  return Offers().contains(browser->GetSessionID().id());
+}
+
+void RangaResolveCrashedSession(BrowserWindowInterface* browser,
+                                bool restore) {
+  auto it = Offers().find(browser->GetSessionID().id());
+  if (it == Offers().end()) {
+    return;
+  }
+  std::unique_ptr<ExitTypeService::CrashedLock> lock =
+      std::move(it->second.lock);
+  Offers().erase(it);
+  if (restore) {
+    SessionRestore::RestoreSessionAfterCrash(browser);
+  }
+}
