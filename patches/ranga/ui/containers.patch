+ExtensionFunction::ResponseAction RangaPrivateCreateTabFunction::Run() {
+  auto params = ranga_private::CreateTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const ranga_private::CreateTabOptions& options = params->options;
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, options.window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  GURL url(chrome::kChromeUINewTabURL);
+  if (options.url && !options.url->empty()) {
+    url = GURL(*options.url);
+    if (!url.is_valid()) {
+      return RespondNow(Error(kBadUrlError, *options.url));
+    }
+  }
+  content::BrowserContext* context = browser->GetProfile();
+  scoped_refptr<content::SiteInstance> site_instance =
+      options.container.empty()
+          ? content::SiteInstance::CreateForURL(context, url)
+          : content::SiteInstance::CreateForFixedStoragePartition(
+                context, url,
+                RangaContainerPartition(context, options.container));
+  const bool active = options.active.value_or(true);
+  content::WebContents::CreateParams create_params(context,
+                                                    std::move(site_instance));
+  create_params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* raw = contents.get();
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+  int add_types = active ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE;
+  if (options.pinned.value_or(false)) {
+    add_types |= AddTabTypes::ADD_PINNED;
+  }
+  browser->GetTabStripModel()->AddWebContents(
+      std::move(contents), options.index.value_or(TabStripModel::kNoTab),
+      ui::PAGE_TRANSITION_AUTO_TOPLEVEL, add_types);
+  return RespondNow(WithArguments(ExtensionTabUtil::GetTabId(raw)));
+}
+
+ExtensionFunction::ResponseAction RangaPrivateGetTabContainersFunction::Run() {
+  auto params = ranga_private::GetTabContainers::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  std::vector<ranga_private::TabContainer> tabs;
+  TabStripModel* model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    std::string container = RangaContainerOf(contents);
+    if (container.empty()) {
+      continue;
+    }
+    ranga_private::TabContainer entry;
+    entry.tab_id = ExtensionTabUtil::GetTabId(contents);
+    entry.container = std::move(container);
+    tabs.push_back(std::move(entry));
+  }
+  return RespondNow(
+      ArgumentList(ranga_private::GetTabContainers::Results::Create(tabs)));
+}
+
+ExtensionFunction::ResponseAction RangaPrivateClearContainerFunction::Run() {
+  auto params = ranga_private::ClearContainer::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->container.empty()) {
+    return RespondNow(Error(kNoContainerError));
+  }
+  content::StoragePartition* partition = browser_context()->GetStoragePartition(
+      RangaContainerPartition(browser_context(), params->container));
+  auto cookies = network::mojom::CookieDeletionFilter::New();
+  cookies->session_control =
+      network::mojom::CookieDeletionSessionControl::IGNORE_CONTROL;
+  pending_ = 2;
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL,
+      /*filter_builder=*/nullptr,
+      content::StoragePartition::StorageKeyPolicyMatcherFunction(),
+      std::move(cookies), /*perform_storage_cleanup=*/true, base::Time(),
+      base::Time::Max(),
+      base::BindOnce(&RangaPrivateClearContainerFunction::OnCleared, this));
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr,
+      base::BindOnce(&RangaPrivateClearContainerFunction::OnCleared, this));
+  return RespondLater();
+}
+
+void RangaPrivateClearContainerFunction::OnCleared() {
+  if (--pending_ == 0) {
+    Respond(NoArguments());
+  }
+}
