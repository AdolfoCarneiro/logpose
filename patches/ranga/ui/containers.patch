+#ifndef CHROME_BROWSER_RANGA_RANGA_CONTAINERS_H_
+#define CHROME_BROWSER_RANGA_RANGA_CONTAINERS_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+inline constexpr char kRangaContainerPartitionDomain[] = "ranga-container";
+
+inline content::StoragePartitionConfig RangaContainerPartition(
+    content::BrowserContext* context,
+    const std::string& name) {
+  return content::StoragePartitionConfig::Create(
+      context, kRangaContainerPartitionDomain, name,
+      context->IsOffTheRecord());
+}
+
+inline bool IsRangaContainerPartition(
+    const content::StoragePartitionConfig& config) {
+  return !config.is_default() &&
+         config.partition_domain() == kRangaContainerPartitionDomain;
+}
+
+inline std::string RangaContainerOf(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  const content::StoragePartitionConfig& config =
+      contents->GetSiteInstance()
+          ->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  return IsRangaContainerPartition(config) ? config.partition_name()
+                                           : std::string();
+}
+
+inline scoped_refptr<content::SiteInstance> RangaContainerSiteInstanceFor(
+    content::WebContents* source,
+    const GURL& url) {
+  if (!source) {
+    return nullptr;
+  }
+  const content::StoragePartitionConfig& config =
+      source->GetSiteInstance()
+          ->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  if (!IsRangaContainerPartition(config)) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      source->GetBrowserContext(), url, config);
+}
+
+inline base::FilePath RangaContainerPartitionsPath() {
+  return base::FilePath(FILE_PATH_LITERAL("Storage"))
+      .Append(FILE_PATH_LITERAL("ext"))
+      .AppendASCII(kRangaContainerPartitionDomain);
+}
+
+#endif  // CHROME_BROWSER_RANGA_RANGA_CONTAINERS_H_
