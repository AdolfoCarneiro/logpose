 using optimization_guide::UserVisibleFeatureKey;
 
+namespace {
+
+// Closing settings goes back to the tab used before it, not to its neighbor.
+// The only tab in the window becomes a new tab instead of closing the window.
+void RangaCloseSettings(base::WeakPtr<content::WebContents> contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents.get())
+               : nullptr;
+  if (!tab || !tab->GetBrowserWindowInterface()) {
+    return;
+  }
+  TabStripModel* model = tab->GetBrowserWindowInterface()->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(contents.get());
+  int previous = TabStripModel::kNoTab;
+  for (int i = 0; i < model->count(); ++i) {
+    if (i != index &&
+        (previous == TabStripModel::kNoTab ||
+         model->GetWebContentsAt(i)->GetLastActiveTimeTicks() >
+             model->GetWebContentsAt(previous)->GetLastActiveTimeTicks())) {
+      previous = i;
+    }
+  }
+  if (previous == TabStripModel::kNoTab) {
+    contents->GetController().LoadURL(GURL(chrome::kChromeUINewTabURL),
+                                      content::Referrer(),
+                                      ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                      std::string());
+    return;
+  }
+  model->ActivateTabAt(previous);
+  model->CloseWebContentsAt(model->GetIndexOfWebContents(contents.get()),
+                            TabCloseTypes::CLOSE_USER_GESTURE);
+}
+
+}  // namespace
