#!/usr/bin/env bash
root="$(git rev-parse --show-toplevel)"
[ "$1" = origin ] || exit 0
while read -r _ local_sha remote_ref _; do
  [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ] || continue
  systemd-run --user --collect --quiet --unit="ranga-release-${local_sha:0:10}" \
    --setenv=PATH="$PATH" --working-directory="$root" "$root/ranga/bin/ranga-release" "$local_sha" \
    && echo "ranga: release de ${local_sha:0:10} começa quando o push terminar (journalctl --user -u ranga-release-${local_sha:0:10})"
done
exit 0
