#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="${RANGA_PROFILE:-$HOME/.local/share/ranga/dev-profile}"

exec "$root/build/src/out/Default/helium" \
  --user-data-dir="$profile" \
  --ozone-platform=wayland \
  --ranga-sidebar-dir="$root/ranga/sidebar" \
  ${RANGA_EXTRA_EXTENSIONS:+--load-extension="$RANGA_EXTRA_EXTENSIONS"} \
  "$@"
