#!/usr/bin/env bash
set -euo pipefail

repo="${RANGA_REPO:-taigakilla/ranga}"
prefix="${RANGA_PREFIX:-$HOME/.local/opt/ranga}"
bindir="${RANGA_BINDIR:-$HOME/.local/bin}"
profile="${RANGA_PROFILE:-$HOME/.local/share/ranga/profile}"

run_id="${1:-$(gh run list -R "$repo" -w "Ranga build" -s success -L 1 --json databaseId -q '.[0].databaseId')}"
[ -n "$run_id" ] || { echo "nenhum build com sucesso em $repo" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

gh run download "$run_id" -R "$repo" -p 'helium-*-x86_64-linux' -D "$work"
tarball="$(find "$work" -name '*_linux.tar.xz' | head -n1)"
[ -n "$tarball" ] || { echo "artefato sem tar.xz no run $run_id" >&2; exit 1; }

version="$(basename "$tarball" _linux.tar.xz)"
dest="$prefix/$version"
mkdir -p "$dest" "$bindir" "$profile"
tar -xJf "$tarball" -C "$dest" --strip-components=1
ln -sfn "$dest" "$prefix/current"

cat > "$bindir/ranga" <<EOF
#!/usr/bin/env bash
exec "$prefix/current/helium" --user-data-dir="$profile" --class=ranga "\$@"
EOF
chmod +x "$bindir/ranga"
echo "$version"
