#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
id="${1:?uso: ranga-theme-install <id-da-extensao>}"
profile="${RANGA_PROFILE:-$HOME/.local/share/ranga/profile}"

mkdir -p "$HOME/.config/ciel/hooks/theme-set.d"
ln -sfn "$root/ranga/theme/hook-theme-set" "$HOME/.config/ciel/hooks/theme-set.d/ranga"

for dir in "$profile" "$HOME/.local/share/ranga/dev-profile"; do
  mkdir -p "$dir/NativeMessagingHosts"
  cat > "$dir/NativeMessagingHosts/ranga.theme.json" <<JSON
{
  "name": "ranga.theme",
  "description": "Ranga: tema do Ciel",
  "path": "$root/ranga/theme/ranga_theme_host.py",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://$id/"]
}
JSON
done

"$root/ranga/theme/hook-theme-set"
echo "ok"
